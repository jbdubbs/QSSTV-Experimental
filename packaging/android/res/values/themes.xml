<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar (the window covers the whole screen and keeps clear of the system bars itself), and the window colour of
         the program from the first frame on; DayNight follows the system's light/dark setting (values-v31 adds the colour of the
         start-up screen of Android 12 and later). -->
    <style name="QSSTVTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
